# Copy to .env (gitignored) next to docker-compose.yml and fill in.
# All three OAuth values are required for tastytrade market data; leave them
# blank to run without it.
TASTYTRADE_CLIENT_ID=
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
# Optional: point the client at a different API base (e.g. a local mock).
TASTYTRADE_API_BASE=
